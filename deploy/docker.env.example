# Copy to deploy/docker.env and fill in. deploy/docker.env is gitignored; never
# commit real values. Read by the app container only; Caddy has its own, smaller
# file (deploy/caddy.env) so it never sees these secrets.

# --- Public address ---
# No trailing slash. CORS_ORIGINS must also be set in production, even though the
# client and API share one origin here; it is the same value as PUBLIC_URL.
PUBLIC_URL=https://hms.example.org
CORS_ORIGINS=https://hms.example.org

# --- Database: an external MySQL 8 server reached over TLS ---
# Production refuses to connect without TLS. If the server's certificate is not
# signed by a public CA, mount its CA file into the app container (see the
# commented volume in docker-compose.yml) and point DATABASE_SSL_CA at it.
DATABASE_URL=mysql://hms_user:CHANGE_ME@db.example.org:3306/hospital
DATABASE_SSL=true
# DATABASE_SSL_CA=/run/secrets/db-ca.pem

# --- Secrets: generate with `openssl rand -base64 48` and store them elsewhere too ---
JWT_SECRET=
# Without this key backups are plaintext, and production will not start.
BACKUP_ENCRYPTION_KEY=

# --- Password-reset email (production will not start without these) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=Hospital Management System <no-reply@hms.example.org>

APP_TIMEZONE=Africa/Kigali
ALLOW_SIMULATED_PAYMENTS=false
MOBILE_MONEY_ENABLED=false
MAIL_LOG_TOKENS=false

# Leave unset. Production refuses to start on the demonstration drug-interaction
# data; load a licensed dataset with `npm run db:interactions` instead. Set to true
# only for an isolated demo, never with real patients.
# ALLOW_DEMO_INTERACTIONS=false

# Optional: require authenticator-app sign-in for these roles.
# MFA_REQUIRED_ROLES=admin,doctor

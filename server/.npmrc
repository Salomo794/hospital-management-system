# The only native module in this package, better-sqlite3, ships a prebuilt
# binary for every supported platform in its tarball. npm still compiles it
# from source because the package ships a binding.gyp and no install script,
# so a fresh install needs a C++ toolchain - Visual Studio Build Tools on
# Windows - that has nothing to do with running the hospital.
#
# The prebuilt binary is what actually loads, so the build is pure waste. Turn
# the scripts off and use it. The one other package with an install script is
# fsevents, which is macOS-only, optional, and falls back to polling when it
# has no binary.
ignore-scripts=true

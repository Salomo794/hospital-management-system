PORT=5000
# Replace this placeholder with a unique random value of at least 32 characters.
JWT_SECRET=change_this_to_a_secure_random_string
JWT_EXPIRE=7d
PORTAL_JWT_EXPIRE=24h
# Comma-separated production origins, for example: https://hms.example.com
CORS_ORIGINS=
# Optional. Relative paths are resolved from the server directory (the folder containing package.json).
# DB_PATH=hospital.db
# Demo portal payments are available only in development/test when explicitly enabled.
ALLOW_SIMULATED_PAYMENTS=false

# The timezone the hospital operates in, as an IANA zone name. Anything that
# means "today" - daily takings, the check-in queue, overdue stock - is resolved
# against this, not the server's UTC clock. Timestamps are still stored in UTC.
# Defaults to Africa/Kigali (East Africa Time, UTC+2).
APP_TIMEZONE=Africa/Kigali

# --- Mobile money via Paystack ---
# IMPORTANT: Paystack only offers the mobile money channel in Ghana, Kenya and
# Côte d'Ivoire. It is licensed in Rwanda but does not sell mobile money there,
# so MTN MoMo and Airtel Money cannot be charged through it. A Rwandan
# deployment needs a provider that does support it (Mukuru or Cellulant) behind
# a separate adapter.
#
# Off unless MOBILE_MONEY_ENABLED is true AND a provider secret is present.
MOBILE_MONEY_ENABLED=false
# 'paystack' for real charges. Leave unset to let the API infer it from the key.
MOBILE_MONEY_PROVIDER=
# Live keys start sk_live_, sandbox keys start sk_test_. Use sandbox while testing.
PAYSTACK_SECRET_KEY=
# Optional. Defaults to PAYSTACK_SECRET_KEY, which is what Paystack signs with.
PAYSTACK_WEBHOOK_SECRET=
# The currency the hospital bills in, which must match the Paystack account.
# This also selects the market: GHS Ghana, KES Kenya, XOF Côte d'Ivoire, RWF Rwanda.
PAYSTACK_CURRENCY=NGN
# Optional. Overrides the market inferred from the currency above.
# One of: ghana, kenya, ivory_coast, rwanda
# PAYSTACK_MARKET=
# Where Paystack returns the patient after they approve. Must be publicly reachable.
PAYSTACK_CALLBACK_URL=
# Development and test only, and refused when NODE_ENV=production. Simulates the
# provider so the pending -> settled lifecycle can be exercised without an account.
MOBILE_MONEY_MOCK=false

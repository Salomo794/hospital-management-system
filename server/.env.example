PORT=5000
# Replace this placeholder with a unique random value of at least 32 characters.
JWT_SECRET=change_this_to_a_secure_random_string
JWT_EXPIRE=7d
PORTAL_JWT_EXPIRE=24h
# Comma-separated production origins, for example: https://hms.example.com
CORS_ORIGINS=
# Optional. Relative paths are resolved from the server directory (the folder containing package.json).
# DB_PATH=hospital.db
# Demo portal payments are available only in development/test when explicitly enabled.
ALLOW_SIMULATED_PAYMENTS=false

# --- Backups ---
# Encrypts every backup with AES-256-GCM. A backup is a complete copy of the
# patient database, and the point of moving one off the machine is that it ends up
# somewhere less controlled - a share, an object store, a laptop. Without this,
# that copy is the weakest link rather than the database.
#
# Any passphrase works; it is stretched into a key with scrypt, so length and
# variety matter more than symbols. It MUST be stored somewhere other than this
# file, because a backup that cannot be opened is not a backup. There is no
# recovery if it is lost.
#
# Set it to a real value before taking a backup you intend to keep. Leaving it
# unset writes plaintext archives and says so.
BACKUP_ENCRYPTION_KEY=REPLACE_ME

# --- Mail ---
# Password reset emails are logged instead of sent when SMTP is not configured.
# The message body contains a single-use reset link, which is a credential, so it
# is withheld by default. Set this to true only in local development, and never
# on a machine that can see real data.
MAIL_LOG_TOKENS=false

# The timezone the hospital operates in, as an IANA zone name. Anything that
# means "today" - daily takings, the check-in queue, overdue stock - is resolved
# against this, not the server's UTC clock. Timestamps are still stored in UTC.
# Defaults to Africa/Kigali (East Africa Time, UTC+2).
APP_TIMEZONE=Africa/Kigali

# --- Password reset by email ---
# The reset link points at the client, so this must be the address a staff member
# can actually open, with no trailing slash. Defaults to http://localhost:3000.
PUBLIC_URL=http://localhost:3000
# Without SMTP, resets are refused in production (HTTP 503) rather than silently
# not sent. In development and test the email is written to the server console,
# which is how the flow is exercised locally.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); false for STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to "Hospital Management System <no-reply@SMTP_HOST>".
# SMTP_FROM=Hospital Management System <no-reply@hospital.example>
# How long a reset link stays usable, and how often one may be requested.
# Defaults: 30 minutes, 3 per address per 15 minutes, 60 per IP per hour.
# PASSWORD_RESET_MINUTES=30
# PASSWORD_RESET_MAX_PER_EMAIL=3
# PASSWORD_RESET_MAX_PER_IP=60

# --- Mobile money via Paystack ---
# IMPORTANT: Paystack only offers the mobile money channel in Ghana, Kenya and
# Côte d'Ivoire. It is licensed in Rwanda but does not sell mobile money there,
# so MTN MoMo and Airtel Money cannot be charged through it. A Rwandan
# deployment needs a provider that does support it (Mukuru or Cellulant) behind
# a separate adapter.
#
# Rwanda's networks (MTN MoMo, Airtel Money) are still defined, because they are
# the real ones there, but Paystack is not offered them and the rail stays off
# for a Rwandan market by default.
#
# Off unless MOBILE_MONEY_ENABLED is true AND a provider secret is present.
MOBILE_MONEY_ENABLED=false
# 'paystack' for real charges. Leave unset to let the API infer it from the key.
MOBILE_MONEY_PROVIDER=
# Live keys start sk_live_, sandbox keys start sk_test_. Use sandbox while testing.
PAYSTACK_SECRET_KEY=
# Optional. Defaults to PAYSTACK_SECRET_KEY, which is what Paystack signs with.
PAYSTACK_WEBHOOK_SECRET=
# The currency the hospital bills in, which must match the Paystack account.
# This also selects the market: GHS Ghana, KES Kenya, XOF Côte d'Ivoire, RWF Rwanda.
PAYSTACK_CURRENCY=NGN
# Optional. Overrides the market inferred from the currency above.
# One of: ghana, kenya, ivory_coast, rwanda
# PAYSTACK_MARKET=
# Where Paystack returns the patient after they approve. Must be publicly reachable.
PAYSTACK_CALLBACK_URL=
# Development and test only, and refused when NODE_ENV=production. Simulates the
# provider so the pending -> settled lifecycle can be exercised without an account.
MOBILE_MONEY_MOCK=false
# Development and test only, and refused when NODE_ENV=production. Offers the
# configured market's networks even when Paystack cannot charge that market, so a
# Rwandan build can exercise MTN MoMo and Airtel Money locally. It changes what is
# offered, not what Paystack accepts: a real charge in an unsupported market will
# still fail, which is why this cannot be enabled in production.
PAYSTACK_ALLOW_UNSUPPORTED_MARKET=false

# --- Mobile money via Mukuru: AWAITING CREDENTIALS AND API CONTRACT ---
# NOT IMPLEMENTED. Do not set MOBILE_MONEY_PROVIDER=mukuru yet: no adapter exists,
# and the configuration endpoint will say so rather than pretend.
#
# Mukuru publishes no public developer API, OpenAPI spec or SDK. The documentation
# and sandbox access are supplied to a customer by their account manager during
# onboarding, so the real endpoint contract has to come from Mukuru before any
# adapter can be written against it. Guessing it would produce an integration that
# compiles, passes every check, and cannot take a patient's money.
#
# Put the values Mukuru gives you here. This file is a template, so fill these in
# your own server/.env, which is gitignored.
#
# MUKURU_BASE_URL=https://sandbox...   # the sandbox host they give you
# MUKURU_API_KEY=
# MUKURU_API_SECRET=
# MUKURU_APP_ID=                       # if your account is issued one
# MUKURU_COUNTRY=RW

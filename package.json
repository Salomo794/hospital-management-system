{
  "name": "hospital-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Modern Hospital Management System",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "db:setup": "node server/config/setup.js",
    "db:seed": "node server/config/seed.js",
    "db:backup": "node server/config/backup.js",
    "build": "npm run build --prefix client",
    "lint": "npm run lint --prefix client",
    "lint:fix": "npm run lint:fix --prefix client",
    "test": "npm test --prefix server",
    "test:client": "npm test --prefix client",
    "test:all": "npm test && npm run test:client",
    "check": "npm run lint && npm run build && npm run test:all",
    "audit": "npm audit --omit=dev && npm audit --omit=dev --prefix server && npm audit --omit=dev --prefix client"
  },
  "dependencies": {
    "concurrently": "^8.2.0"
  }
}

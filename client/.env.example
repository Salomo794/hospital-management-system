# Optional. Overrides the API target used by the Vite dev-server proxy.
# Defaults to http://localhost:5000.
# VITE_API_PROXY_TARGET=http://localhost:5000

# Currency shown on screen (ISO 4217 code). Defaults to USD. Display only: stored amounts are not converted.
# VITE_CURRENCY=RWF
# VITE_CURRENCY_LOCALE=en-US

# Caddyfile for Hospital Management System
#
# Terminates TLS in front of the Node.js/Express API and serves the built
# client from `client/dist` on the same origin (no CORS needed between client
# and API in the single-service deployment).
#
# Usage:
#   caddy run                  # foreground
#   caddy start                # background
#
# Replace `hms.example.org` with your real deployment hostname. Caddy obtains
# and renews a certificate automatically via ACME (Let's Encrypt by default).

{
    email admin@example.org
    # Debug logging can be enabled per deployment:
    # log {
    #     output file /var/log/caddy/access.log
    #     format json
    # }
}

# Redirect bare domain / www to the canonical HTTPS origin.
http://hms.example.org {
    redir https://hms.example.org{uri} permanent
}

# Main HTTPS service.
hms.example.org {

    # Reverse proxy to the HMS API. Trust the proxy so req.ip reflects the
    # original client IP (the app sets `trust proxy` when TRUST_PROXY=true).
    reverse_proxy localhost:5000 {
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # Serve health checks directly so monitoring can reach the service without
    # touching the application when it is degraded. The app still answers
    # /api/health; this is a front-door convenience.
    handle /api/health {
        reverse_proxy localhost:5000
    }

    # Static files from the built client, served by Caddy (faster than Express,
    # and keeps cookie/header handling simple).
    root * /srv/hms/client/dist
    file_server

    # Fall back to the SPA index.html for client-side routes.
    try_files {path} /index.html

    # Security headers.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        # Content-Security-Policy should be tuned per deployment:
        # Content-Security-Policy "default-src 'self'; ..."
    }
}